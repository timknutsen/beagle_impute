# Snakefile_accuracy — imputation accuracy evaluation
#
# Measures how accurately each imputer recovers genotypes it was not given,
# by animal-level K-fold cross-validation against known truth.
#
# Usage:
#   snakemake --snakefile Snakefile_accuracy --use-conda --cores 8
#
# Two modes (set accuracy_mode in config_accuracy.yaml):
#
#   kfold_mask_and_impute
#                    One bfile. Each fold's held-out animals are masked to a
#                    shared LD panel; the remaining folds stay full density as
#                    the reference. cv.folds_to_run: [1] gives a single
#                    hold-out for a quick check.
#
#   cross_array      Same animals genotyped on two arrays, scored K-fold. Each
#                    fold contributes its real low-density typings; the other
#                    folds' high-density genotypes are the reference panel. An
#                    identity gate drops animals whose two typings are not the
#                    same physical fish before anything is scored.
#
# Tool configuration (beagle_jar, plink_path, etc.) is inherited from the
# main config.yaml; accuracy-specific settings come from config_accuracy.yaml.

configfile: "config.yaml"
configfile: "config_accuracy.yaml"

include: "rules/common.smk"

_acc_mode = config.get("accuracy_mode", "kfold_mask_and_impute")
_acc_out  = config.get("accuracy_output_dir", "accuracy_output")

if _acc_mode == "mask_and_impute":
    raise ValueError(
        "accuracy_mode: mask_and_impute was removed: with Beagle it imputed "
        "nothing (no reference panel) and it had no FImpute path. A single "
        "hold-out is now one fold of kfold_mask_and_impute, e.g. "
        "--config accuracy_mode=kfold_mask_and_impute cv_n_folds=5 cv_folds_to_run=1"
    )
if _acc_mode not in ("kfold_mask_and_impute", "cross_array"):
    raise ValueError(
        f"Unknown accuracy_mode: {_acc_mode!r}. "
        "Use 'kfold_mask_and_impute' or 'cross_array'."
    )


def _cross_array_bfile(side):
    bfile = str(nested_config("cross_array", f"{side}_bfile", "") or "").strip()
    if not bfile:
        raise ValueError(
            f"accuracy_mode: cross_array needs cross_array.{side}_bfile "
            f"(or the flat alias cross_array_{side}_bfile=)."
        )
    return bfile


def acc_get_chromosomes():
    """
    Chromosomes to impute and score.

    For cross_array the source is the *high-density* array: it is the superset,
    it defines the truth, and a chromosome carried only by it would otherwise
    never be imputed or scored.
    """
    if _acc_mode == "cross_array":
        return sorted_chromosomes(_cross_array_bfile("hd"))
    return sorted_chromosomes(config["bfile"])


include: "rules/accuracy.smk"


rule accuracy_all:
    """
    The run-level comparison, the per-imputer means, and the per-marker
    reliability table the reference panel is chosen from. cross_array adds
    identity.tsv, so the pairing evidence is a required output rather than a
    side effect someone may or may not look at.
    """
    input:
        _acc_out + "/cv_summary.tsv",
        _acc_out + "/cv_imputer_summary.tsv",
        _acc_out + "/snp_reliability.tsv",
        _acc_out + "/reliable_markers.txt",
        [_acc_out + "/setup/identity.tsv"] if _acc_mode == "cross_array" else [],
